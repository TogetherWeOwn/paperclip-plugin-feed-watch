{
  "name": "@togetherweown/paperclip-plugin-feed-watch",
  "version": "0.1.0",
  "description": "Disabled-by-default deterministic YouTube feed intake for Paperclip research cards",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.11.0"
  },
  "packageManager": "npm@11.19.0",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "paperclipPlugin": {
    "manifest": "./dist/manifest.js",
    "worker": "./dist/worker.js"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "node build.mjs",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@paperclipai/plugin-sdk": "2026.1023.0",
    "fast-xml-parser": "5.11.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261025.1",
    "@types/node": "24.10.0",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  }
}
